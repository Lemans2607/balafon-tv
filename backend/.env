# ============================================================
# BALAFON + GUIDE — variables d'environnement backend
# Ce fichier est lu par settings.py via python-dotenv.
# NE JAMAIS committer un vrai .env de production.
# ============================================================

DEBUG=True
SECRET_KEY=django-insecure-a-changer-en-production

# ------------------------------------------------------------ Moteur de BDD
# DB_ENGINE=sqlite      → SQLite local, AUCUN service externe requis.
#                         Idéal pour développer sans installer PostgreSQL.
# DB_ENGINE=postgresql  → PostgreSQL 16 (docker compose up -d, ou natif).
#
# Par défaut on démarre en SQLite pour que `runserver` fonctionne tout de suite.
# Passez à postgresql quand PostgreSQL est prêt (voir plus bas).
DB_ENGINE=sqlite

# ------------------------------------------------------------ PostgreSQL
# (utilisé uniquement si DB_ENGINE=postgresql)
# docker-compose.yml crée exactement ces valeurs par défaut.
DB_NAME=balafon_tv
DB_USER=postgres
DB_PASSWORD=balafon_dev_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------ Divers
TIME_ZONE=Africa/Douala
