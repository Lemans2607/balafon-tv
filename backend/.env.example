# BALAFON + GUIDE — backend Django (copier en .env, ne jamais committer)
DEBUG=True
SECRET_KEY=django-insecure-change-moi-avant-production

# PostgreSQL locale (valeurs par défaut du cahier des charges)
DB_NAME=balafon_tv
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS — origines frontend autorisées (déjà dans settings, surcharge possible)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Fuseau de référence de toute la plateforme
TIME_ZONE=Africa/Douala
