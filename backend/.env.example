# BALAFON + GUIDE — backend Django (copier en .env, ne jamais committer .env)
DEBUG=True
SECRET_KEY=django-insecure-change-moi-avant-production

# PostgreSQL (voir docker-compose.yml)
DB_NAME=balafon_guide
DB_USER=balafon_admin
DB_PASSWORD=balafon_dev_password
DB_HOST=localhost
DB_PORT=5432

# Redis (channel layer — WebSocket temps réel)
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS — origines frontend autorisées
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3000

# Intégration vMix
#   simule → aucune requête réelle n'est émise (soutenance / démo)
#   reel   → appels HTTP vers la régie
VMIX_MODE=simule
VMIX_API_URL=http://192.168.1.50:8088/api
VMIX_API_TIMEOUT=5

# Fuseau de référence de toute la plateforme
TIME_ZONE=Africa/Douala
