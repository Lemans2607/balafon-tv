# ============================================================
# BALAFON + GUIDE — variables d'environnement (exemple)
# Copier en .env.local pour le développement.
# ============================================================

# --- API backend (future intégration Django + PostgreSQL) ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# --- Chaîne pilotée (portail public = Balafon TV uniquement) ---
VITE_CHANNEL_ID=balafon-tv
VITE_CHANNEL_NAME=Balafon TV
VITE_TIMEZONE=Africa/Douala

# --- Intégration vMix (future API REST / WebSocket) ---
# Mode démonstration par défaut : aucune connexion réelle.
VITE_VMIX_MODE=simulated
VITE_VMIX_API_URL=http://regie.balafon.local:8088/API
VITE_VMIX_WS_URL=ws://regie.balafon.local:8099

# --- Feature flags ---
VITE_ENABLE_REPLAY=true
VITE_ENABLE_PUBLIC_PORTAL=true
