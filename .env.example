# ============================================================
# BALAFON + GUIDE — variables d'environnement frontend (exemple)
# Copier en .env.local pour le développement.
# Sans VITE_API_URL, l'app fonctionne en mode démo local
# (catalogue embarqué + localStorage) — jamais d'écran vide.
# ============================================================

# --- API backend Django + PostgreSQL (Phase 4 du guide) ---
# Laisser vide pour le mode démo.
VITE_API_URL=http://localhost:8000/api

# --- WebSocket alertes temps réel (Django Channels + Redis) ---
VITE_WS_URL=ws://localhost:8000/ws/alertes/

# --- Chaîne pilotée (portail public = Balafon TV uniquement) ---
VITE_CHANNEL_ID=balafon-tv
VITE_CHANNEL_NAME=Balafon TV
VITE_TIMEZONE=Africa/Douala

# --- Intégration vMix (simulation par défaut) ---
VITE_VMIX_MODE=simulated
VITE_VMIX_API_URL=http://regie.balafon.local:8088/API
VITE_VMIX_WS_URL=ws://regie.balafon.local:8099

# --- Feature flags ---
VITE_ENABLE_REPLAY=true
VITE_ENABLE_PUBLIC_PORTAL=true
